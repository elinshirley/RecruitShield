{
  "manifest_version": 3,
  "name": "Recruitment Scam Detector",
  "version": "1.0",
  "description": "Detect suspicious job postings using AI-powered trust scoring.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://www.indeed.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Recruitment Scam Detector"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.naukri.com/*",
        "https://www.indeed.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}